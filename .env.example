# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically start and use the embedded MongoDB Memory Server in local dev/tests
MONGODB_URI=

# Security & Authentication Secrets
# Ensure these secrets are at least 32 characters in production environments
JWT_SECRET=pulsechat_jwt_secret_key_minimum_32_chars_long_prod!
JWT_REFRESH_SECRET=pulsechat_jwt_refresh_secret_key_minimum_32_chars!

# AES-256-GCM Session Storage Encryption Key (32-byte hex string or 32+ character secret)
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist Origin
CORS_ORIGIN=http://localhost:5173

# Responsible Messaging & Rate Limits
MAX_MESSAGES_PER_MINUTE=30
MESSAGE_COOLDOWN_SECONDS=2
